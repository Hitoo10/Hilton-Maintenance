{
  "expo": {
    "name": "Hilton Maintenance",
    "slug": "hilton-maintenance",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hiltonmaintenance",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B1220",
    "splash": {
      "backgroundColor": "#0B1220",
      "resizeMode": "contain",
      "image": "./assets/icon.png",
      "imageWidth": 200
    },
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.technicians.hiltonmaintenance",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1220"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#2F7DFF"
        }
      ],
      "expo-image-picker",
      "expo-asset"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "bc08623e-255e-4554-a9d9-7d946f8cfa80"
      }
    },
    "owner": "hitoo1"
  }
}
